# Copy to .env before running docker compose up.
# .env is gitignored; this file is the committed record of what is required.

# Set to true only in development. With it off, ErrorHandler returns a generic
# 500 page and logs the exception instead of rendering it to the browser.
APP_DEBUG=true

# Allows htmx hx-on: handlers and event filters, which htmx compiles with
# new Function. Set to false to forbid eval for the whole origin; behaviour
# written in hyperscript's _ attributes works either way.
CSP_ALLOW_EVAL=true

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lamp_db
MYSQL_USER=lamp_user
MYSQL_PASSWORD=change-me
